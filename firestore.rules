rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // 이 쓰기가 바꾸는 필드가 주어진 하나뿐인지.
    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    // 수가 1만큼 오르거나 내렸는지. 추천·스크랩처럼 켜고 끄는 값에 쓴다.
    function steppedBy(field, allowDecrease) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return after - before == 1 || (allowDecrease && before - after == 1);
    }

    // 하루 공유 한도(10개). 날짜는 한국 시간 기준이고 앱의 share_quota 문서 id와 같은 형식이다.
    function shareDayKey() {
      let t = request.time + duration.value(9, 'h');
      return string(t.year()) + '-' + string(t.month()) + '-' + string(t.day());
    }
    function shareQuotaPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/share_quota/$(shareDayKey());
    }
    // 공개로 바꾸는 쓰기는 같은 요청에서 오늘 공유 횟수를 1 올리고 10을 넘지 않아야 한다.
    function shareQuotaUsed(uid) {
      return getAfter(shareQuotaPath(uid)).data.count <= 10
        && getAfter(shareQuotaPath(uid)).data.count
          == (exists(shareQuotaPath(uid)) ? get(shareQuotaPath(uid)).data.count : 0) + 1;
    }

    // 유저 (프로필, 닉네임 등) 설정
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      // 두 번째 조건은 질문 답변 채택(acceptAnswer)이 답변자의 크래커를
      // 올려 주기 위한 것이다. 전에는 값에 아무 제한이 없어서, 로그인한
      // 사람이 남의 크래커를 0으로 만들 수도 있었다. 올리는 쪽만 둔다.
      //
      // 자기 문서는 여전히 통째로 쓸 수 있으므로, 본인이 자기 크래커와
      // 패롯을 임의로 올리는 것은 이 규칙으로 막지 못한다. 그건 지급을
      // 서버로 옮겨야 하는 문제다.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (changesOnly(['crackers'])
          && request.resource.data.crackers > resource.data.crackers)
      );
      
      // 내가 누른 추천·스크랩·댓글 좋아요·투표 기록.
      // 전에는 네 컬렉션 모두 read, write가 if true였다. 로그인하지 않아도
      // 남의 기록을 읽고 지울 수 있었다. 앱은 언제나 자기 uid 아래만
      // 읽고 쓴다(toggleLike, toggleScrap, toggleCommentLike, votePost).
      match /likes/{postId} {
        allow read, write: if isOwner(userId);
      }
      match /scraps/{postId} {
        allow read, write: if isOwner(userId);
      }
      match /comment_likes/{commentId} {
        allow read, write: if isOwner(userId);
      }
      match /voted_posts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // 둘러보기 문장에 내가 누른 좋아요
      match /sentence_likes/{sharedId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 둘러보기 문장을 내가 가져갔다고 세어 둔 기록. 한 문장은 사람마다 한 번만 센다.
      match /sentence_imports/{sharedId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 콘텐츠 namespace
      match /namespaces/{namespaceId} {
        match /groups/{groupId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /groupCollections/{linkId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /collections/{collectionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /clips/{clipId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // 동기화 상태 namespace
      match /share_quota/{day} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && day == shareDayKey()
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count <= 10;
      }

      match /namespaces/{namespaceId}/meta/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // legacy path - 점진적 전환용
      match /syncMeta/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /collections/{collectionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /clips/{clipId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 문장. 내 문장과 둘러보기에 공개된 문장은 같은 문서이고 visibility로 구분한다.
    // - ownerId: 문서를 가진 사람. 읽기(비공개)·수정·삭제의 기준이다.
    // - authorId: 원작자. 남의 공개 문장을 저장한 사본은 원작자가 ownerId와 다르다.
    // - visibility: 'private'은 주인만, 'public'은 로그인한 누구나 읽는다.
    //   공개는 주인이 원작자일 때만 할 수 있어서, 남의 문장은 다시 공유할 수 없다.
    // 목록 조회는 where('visibility', '==', 'public') 또는 where('ownerId', '==', 내 uid)로 해야 한다.
    match /sentences/{sentenceId} {
      allow read: if request.auth != null && (
        resource.data.visibility == 'public'
        || resource.data.ownerId == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.get('importCount', 0) == 0
        && (
          request.resource.data.visibility == 'private'
          || (request.resource.data.visibility == 'public'
              && request.resource.data.authorId == request.auth.uid
              && shareQuotaUsed(request.auth.uid))
        );
      allow update: if request.auth != null && (
        // 주인: 소유자·원작자·좋아요 수는 바꿀 수 없고, 내용과 공개 여부만 바꾼다.
        // 공개로 바꾸려면 내가 원작자여야 한다.
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.get('importCount', 0) == resource.data.get('importCount', 0)
          && (request.resource.data.visibility == 'private'
              || (request.resource.data.visibility == 'public'
                  && resource.data.authorId == request.auth.uid
                  && (resource.data.visibility == 'public'
                      || shareQuotaUsed(request.auth.uid)))))
        // 다른 사람: 공개된 문장의 좋아요 수를 1씩 바꾸거나, 가져간 수를 1 올린다.
        || (resource.data.visibility == 'public'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (request.resource.data.likeCount - resource.data.likeCount == 1
              || resource.data.likeCount - request.resource.data.likeCount == 1))
        || (resource.data.visibility == 'public'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['importCount'])
          && request.resource.data.get('importCount', 0) - resource.data.get('importCount', 0) == 1)
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // 내 단어(5차). 본인만 읽고 쓴다. 공개·둘러보기는 없다.
    // 목록 조회는 where('ownerId', '==', 내 uid)로 해야 한다.
    match /words/{wordId} {
      function validWord(d) {
        return d.ownerId == request.auth.uid
          && d.word is string && d.word.size() > 0 && d.word.size() <= 80
          && d.language is string && d.language.size() <= 20
          && d.get('meaning', '') is string && d.get('meaning', '').size() <= 200
          && d.get('example', '') is string && d.get('example', '').size() <= 300
          && d.get('exampleTranslation', '') is string
          && d.get('exampleTranslation', '').size() <= 300
          && d.get('sourceSentenceId', '') is string
          // 예문 여러 개(5차). 한 단어에 5개까지. 규칙은 목록 안을 하나씩
          // 볼 수 없어 개수만 막고, 글자 수는 앱이 줄여서 올린다
          // (my_word_store.dart의 clipWordExamples).
          && d.get('examples', []) is list
          && d.get('examples', []).size() <= 5
          && d.get('topic', '') is string && d.get('topic', '').size() <= 40;
      }
      allow read, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && validWord(request.resource.data);
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && validWord(request.resource.data);
    }

    // 디바이스 토큰 관리.
    //
    // 앱에서 이 컬렉션을 쓰는 코드는 없다. FCM 토큰은 users 문서의
    // fcmTokens 배열에 들어간다. 전에는 "date가 다르면" 통과하는 길이
    // 있어서, 로그인한 누구나 남의 문서를 덮어쓸 수 있었다. 쓰는 곳이
    // 없으니 주인만으로 좁힌다.
    match /devices/{deviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // 게시글과 댓글.
    //
    // 전에는 posts와 그 하위가 전부 read, write가 if true였다. 로그인하지
    // 않은 누구나 아무 글이나 고치고 지울 수 있었다. 아래는 앱이 실제로
    // 하는 쓰기만 허용한다.
    //
    // - 글: 작성자가 만들고 고치고 지운다.
    // - 수: 조회수·추천수·스크랩수·댓글수는 남이 올린다. 한 번에 한 필드,
    //   한 칸씩만 움직인다.
    // - 투표: voteOptions는 같은 요청에서 내 voters 문서가 새로 생길 때만
    //   바꿀 수 있다. voters 문서는 한 사람당 하나뿐이고 고칠 수 없으므로,
    //   한 사람이 같은 글에 두 번 투표할 수 없다.
    match /posts/{postId} {
      function isAuthor() {
        return isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthor();
      allow update: if isAuthor()
        || (isSignedIn() && changesOnly(['viewCount'])
            && steppedBy('viewCount', false))
        || (isSignedIn() && changesOnly(['likeCount'])
            && steppedBy('likeCount', true))
        || (isSignedIn() && changesOnly(['scrapCount'])
            && steppedBy('scrapCount', true))
        || (isSignedIn() && changesOnly(['commentCount'])
            && steppedBy('commentCount', true))
        || (isSignedIn() && changesOnly(['voteOptions'])
            && !exists(/databases/$(database)/documents/posts/$(postId)/voters/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/voters/$(request.auth.uid)));

      match /comments/{commentId} {
        function isCommentAuthor() {
          return isSignedIn() && resource.data.authorId == request.auth.uid;
        }
        function isPostAuthor() {
          return isSignedIn()
            && get(/databases/$(database)/documents/posts/$(postId)).data.authorId
               == request.auth.uid;
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid;
        // 앱은 댓글을 지우지 않고 status를 'deleted'로 바꾼다.
        allow delete: if false;
        allow update: if (isCommentAuthor()
              && changesOnly(['status', 'content', 'updatedAt']))
          // 답변 채택은 질문을 쓴 사람이 남의 댓글에 표시한다.
          || (isPostAuthor() && changesOnly(['isAccepted', 'updatedAt']))
          || (isSignedIn() && changesOnly(['likeCount'])
              && steppedBy('likeCount', true));
      }

      // 투표한 사람. 문서 id가 투표자의 uid다.
      match /voters/{voterId} {
        allow read: if isSignedIn();
        allow create: if isOwner(voterId);
        // 한 번 투표하면 바꾸거나 지울 수 없다.
        allow update, delete: if false;
      }
    }

    // collectionGroup 쿼리 허용 (내가 쓴 댓글 활동 조회용)
    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn();
    }
    // collectionGroup 쿼리 허용 (투표 참여 내역 조회용)
    match /{path=**}/voters/{voterId} {
      allow read: if isSignedIn();
    }

    // 전역 닉네임 선점. 문서 내용은 {uid, createdAt}이다.
    //
    // 읽기는 열어 둔다. 이메일 회원가입 화면은 계정을 만들기 전에 닉네임
    // 중복을 확인하므로, 그때는 로그인 상태가 아니다.
    //
    // 쓰기는 전에 "로그인한 사람"이면 통과였다. 그래서 남이 쓰는 닉네임
    // 문서를 덮어쓰거나 지워서 가져갈 수 있었다. 앱의 트랜잭션은 주인을
    // 확인하지만, 규칙으로도 막는다.
    // 커뮤니티 신고(5차). 예전에는 앱의 '신고'가 토스트만 띄우고 아무것도
    // 남기지 않았다. 로그인한 사람이 자기 이름으로만 남길 수 있고, 아무도 읽거나
    // 고치거나 지울 수 없다(운영자는 콘솔에서 본다). 필드와 값은 앱
    // community_report_repository.dart와 같다.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['reporterId', 'targetType', 'postId', 'commentId',
              'targetAuthorId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['reporterId', 'targetType', 'postId', 'targetAuthorId',
              'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment']
        && request.resource.data.reason in ['spam', 'abuse', 'sexual', 'other']
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.postId.size() <= 128
        && request.resource.data.targetAuthorId is string
        && request.resource.data.targetAuthorId.size() <= 128
        && (request.resource.data.targetType == 'post'
            ? !('commentId' in request.resource.data)
            : (request.resource.data.commentId is string
               && request.resource.data.commentId.size() > 0
               && request.resource.data.commentId.size() <= 128))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /nicknames/{nickname} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
