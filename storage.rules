rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 사용자 파일은 Cloudflare R2로 옮겼다(functions/src/r2.ts, 앱의
    // UserFileStorage). Firebase Storage는 더 쓰지 않는다.
    //
    // 전에는 users/{uid}/ 와 caption-inputs/{uid}/ 에 소유자 쓰기를 열어
    // 두었다. 옛 앱이 여기로 올리면 서버가 R2에서 못 찾는 파일이 되므로
    // 전부 닫는다. 서버(Admin SDK)는 이 규칙을 거치지 않으니 옮기기 전
    // 영상의 서명 주소 폴백은 그대로 동작한다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
